# Copy to .env and fill in. Never commit .env.

# SEC EDGAR requires a User-Agent that identifies you with a contact email.
# https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT="tieout your-name your-email@example.com"
# Requests per second to sec.gov (SEC limit is 10; capped at 10 in code).
SEC_MAX_RPS=5

# Postgres + pgvector (docker compose locally, Neon in production)
DATABASE_URL=postgresql+psycopg://tieout:tieout@localhost:5432/tieout

# Where downloads and caches live (git-ignored)
DATA_DIR=data

# LLM (free only): Groq or Gemini free tiers, or a local Ollama server.
# LLM_PROVIDER: groq | gemini | ollama | openai_compatible
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
# Free key from https://console.groq.com (no billing needed). Never commit it.
GROQ_API_KEY=
# Gemini: LLM_PROVIDER=gemini, LLM_MODEL=gemini-3.8-flash (or gemini-3.5-flash-lite),
# free key from https://aistudio.google.com/apikey (no billing needed).
GEMINI_API_KEY=
# Free-tier limits for providers that don't publish fixed ones (Gemini: copy your
# project's limits from AI Studio). 0 = built-in preset (Groq) or not enforced.
LLM_RPM=0
LLM_TPM=0
LLM_RPD=0
LLM_TPD=0
# For Ollama: LLM_PROVIDER=ollama and LLM_MODEL=<a model you pulled, e.g. qwen2.5:7b>
# LLM_BASE_URL overrides the provider preset URL.
LLM_BASE_URL=
LLM_API_KEY=

# Agent guardrails
AGENT_MAX_STEPS=6
AGENT_MAX_TOKENS_PER_RUN=30000
# Reasoning effort: low | medium | high (empty = provider default)
LLM_REASONING_EFFORT=
